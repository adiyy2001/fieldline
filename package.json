{
  "name": "fieldline",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4330",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:style": "tsx scripts/check-style.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "ng test --no-watch && vitest run --config vitest.scripts.config.ts",
    "test:coverage": "ng test --no-watch --coverage && vitest run --config vitest.scripts.config.ts",
    "build": "ng build",
    "serve:dist": "tsx scripts/serve-dist.ts",
    "e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm check:style && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm e2e"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "@webgpu/types": "0.1.74",
    "angular-eslint": "22.5.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
